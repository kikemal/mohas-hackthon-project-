// MESMER Program Management — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PROGRAM_MANAGER
  REGIONAL_COORDINATOR
  M_AND_E_OFFICER
  DATA_VERIFIER
  TRAINER
  COACH
  ENUMERATOR
  COMM_OFFICER
  ENTERPRISE_USER
  READ_ONLY_STAKEHOLDER
}

enum EnterpriseStatus {
  ACTIVE
  STALLED
  DROPPED_OUT
  GRADUATED
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  WITHDRAWN
}

enum FormType {
  BASELINE
  ASSESSMENT
  IAP
  COACHING_VISIT
  TRAINING
}

enum BaselineStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum IapSignoff {
  PENDING
  SIGNED_BY_COACH
  SIGNED_BY_ENTERPRISE
  FULLY_SIGNED
}

enum QcStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REVISION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique @db.VarChar(320)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  firstName    String  @map("first_name") @db.VarChar(120)
  lastName     String  @map("last_name") @db.VarChar(120)
  role         Role    @default(ENUMERATOR)
  region       String? @db.VarChar(120)
  phoneNumber  String? @map("phone_number") @db.VarChar(32)
  isActive     Boolean @default(true) @map("is_active")

  // Assigned enterprises (primary field officer / owner link)
  enterprises Enterprise[] @relation("EnterpriseAssignee")

  coachingVisitsAsCoach CoachingVisit[] @relation("CoachingVisitCoach")
  attendances             Attendance[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  qcChecksAsReviewer      QcCheck[]       @relation("QcReviewer")
  syncQueueItems          SyncQueue[]

  baselineFormsSubmitted  BaselineForm[] @relation("BaselineSubmitter")
  assessmentsSubmitted    Assessment[]   @relation("AssessmentSubmitter")
  iapsSubmitted           Iap[]          @relation("IapSubmitter")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role, region])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Enterprise
// -----------------------------------------------------------------------------

model Enterprise {
  id            String           @id @default(uuid()) @db.Uuid
  businessName  String           @map("business_name") @db.VarChar(255)
  contactPerson String           @map("contact_person") @db.VarChar(255)
  phoneNumber   String?          @map("phone_number") @db.VarChar(32)
  region        String           @db.VarChar(120)
  status        EnterpriseStatus @default(ACTIVE)
  consentStatus ConsentStatus    @default(PENDING) @map("consent_status")

  /// Primary assigned system user (enumerator / coach / program contact)
  userId String @map("user_id") @db.Uuid

  user User @relation("EnterpriseAssignee", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  baselineForms  BaselineForm[]
  assessments    Assessment[]
  iaps           Iap[]
  coachingVisits CoachingVisit[]
  attendances    Attendance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([region, status])
  @@index([userId])
  @@map("enterprises")
}

// -----------------------------------------------------------------------------
// BaselineForm
// -----------------------------------------------------------------------------

model BaselineForm {
  id         String         @id @default(uuid()) @db.Uuid
  enterpriseId String       @map("enterprise_id") @db.Uuid
  formType   FormType       @default(BASELINE) @map("form_type")
  status     BaselineStatus @default(DRAFT)
  formData   Json           @map("form_data")

  submittedById String?     @map("submitted_by_id") @db.Uuid

  enterprise  Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy User?      @relation("BaselineSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  qcChecks  QcCheck[]
  evidences Evidence[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enterpriseId, status])
  @@index([submittedById])
  @@map("baseline_forms")
}

// -----------------------------------------------------------------------------
// Assessment
// -----------------------------------------------------------------------------

model Assessment {
  id           String   @id @default(uuid()) @db.Uuid
  enterpriseId String   @map("enterprise_id") @db.Uuid
  formType     FormType @default(ASSESSMENT) @map("form_type")
  score        Float?
  formData     Json     @map("form_data")

  submittedById String? @map("submitted_by_id") @db.Uuid

  enterprise  Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy User?      @relation("AssessmentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  qcChecks  QcCheck[]
  evidences Evidence[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enterpriseId])
  @@index([submittedById])
  @@map("assessments")
}

// -----------------------------------------------------------------------------
// Iap (Individual Action Plan)
// -----------------------------------------------------------------------------

model Iap {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  formType     FormType   @default(IAP) @map("form_type")
  signoff      IapSignoff @default(PENDING)
  actionItems  Json       @map("action_items")

  submittedById String?   @map("submitted_by_id") @db.Uuid

  enterprise  Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy User?      @relation("IapSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  qcChecks  QcCheck[]
  evidences Evidence[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enterpriseId])
  @@index([submittedById])
  @@map("iaps")
}

// -----------------------------------------------------------------------------
// CoachingVisit
// -----------------------------------------------------------------------------

model CoachingVisit {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @map("enterprise_id") @db.Uuid
  coachId      String     @map("coach_id") @db.Uuid
  formType     FormType   @default(COACHING_VISIT) @map("form_type")
  visitDate    DateTime   @map("visit_date") @db.Date
  notes        String?    @db.Text
  status       TaskStatus @default(PENDING)

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  coach      User       @relation("CoachingVisitCoach", fields: [coachId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  evidences Evidence[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([coachId, visitDate])
  @@index([enterpriseId])
  @@map("coaching_visits")
}

// -----------------------------------------------------------------------------
// Training & Attendance
// -----------------------------------------------------------------------------

model Training {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  formType    FormType @default(TRAINING) @map("form_type")
  startDate   DateTime @map("start_date") @db.Timestamptz(6)
  endDate     DateTime @map("end_date") @db.Timestamptz(6)
  location    String?  @db.VarChar(255)

  attendances Attendance[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startDate])
  @@map("trainings")
}

model Attendance {
  id           String  @id @default(uuid()) @db.Uuid
  trainingId   String  @map("training_id") @db.Uuid
  enterpriseId String? @map("enterprise_id") @db.Uuid
  userId       String? @map("user_id") @db.Uuid
  isPresent    Boolean @default(false) @map("is_present")
  notes        String? @db.VarChar(500)

  training   Training    @relation(fields: [trainingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  enterprise Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([trainingId])
  @@index([enterpriseId])
  @@index([userId])
  @@map("attendances")
}

// -----------------------------------------------------------------------------
// Evidence (optional links to one parent record — enforce in application layer)
// -----------------------------------------------------------------------------

model Evidence {
  id          String  @id @default(uuid()) @db.Uuid
  fileUrl     String  @map("file_url") @db.VarChar(2048)
  fileType    String  @map("file_type") @db.VarChar(120)
  description String? @db.Text

  baselineFormId  String? @map("baseline_form_id") @db.Uuid
  assessmentId    String? @map("assessment_id") @db.Uuid
  iapId           String? @map("iap_id") @db.Uuid
  coachingVisitId String? @map("coaching_visit_id") @db.Uuid

  baselineForm  BaselineForm?  @relation(fields: [baselineFormId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessment    Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  iap           Iap?           @relation(fields: [iapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  coachingVisit CoachingVisit? @relation(fields: [coachingVisitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([baselineFormId])
  @@index([assessmentId])
  @@index([iapId])
  @@index([coachingVisitId])
  @@map("evidences")
}

// -----------------------------------------------------------------------------
// QcCheck
// -----------------------------------------------------------------------------

model QcCheck {
  id         String   @id @default(uuid()) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  status     QcStatus @default(PENDING)
  comments   String?  @db.Text

  baselineFormId String? @map("baseline_form_id") @db.Uuid
  assessmentId   String? @map("assessment_id") @db.Uuid
  iapId          String? @map("iap_id") @db.Uuid

  reviewer     User          @relation("QcReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baselineForm BaselineForm? @relation(fields: [baselineFormId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessment   Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  iap          Iap?          @relation(fields: [iapId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewerId])
  @@index([baselineFormId])
  @@index([assessmentId])
  @@index([iapId])
  @@map("qc_checks")
}

// -----------------------------------------------------------------------------
// AuditLog
// -----------------------------------------------------------------------------

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  action     String  @db.VarChar(64)
  entityType String  @map("entity_type") @db.VarChar(120)
  entityId   String  @map("entity_id") @db.Uuid
  changes    Json?   @map("changes")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Notification
// -----------------------------------------------------------------------------

model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  title   String  @db.VarChar(255)
  message String  @db.Text
  isRead  Boolean @default(false) @map("is_read")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// SyncQueue (offline / batch sync)
// -----------------------------------------------------------------------------

model SyncQueue {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  entityType String     @map("entity_type") @db.VarChar(120)
  operation  String     @db.VarChar(32)
  payload    Json       @map("payload")
  status     TaskStatus @default(PENDING)
  retryCount Int        @default(0) @map("retry_count")
  lastError  String?    @map("last_error") @db.Text

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("sync_queues")
}
